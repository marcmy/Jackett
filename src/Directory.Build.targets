<Project>
    <!--
      Fork-owned warning overrides. Kept separate from upstream source files to
      reduce merge conflicts when upstream changes its build or ASP.NET code.

      ASPDEPR005: ForwardedHeadersOptions.KnownNetworks / HttpOverrides.IPNetwork
      ASPDEPR008: WebHost / IWebHostBuilder.Build
      NU1510:     Redundant Microsoft package references in the shared framework
      TODO: Remove these suppressions when the corresponding code is updated.
    -->
    <PropertyGroup>
        <NoWarn>$(NoWarn);ASPDEPR005;ASPDEPR008;NU1510</NoWarn>
    </PropertyGroup>
</Project>
